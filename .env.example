# Environment variables for website-article-writer-agent-v3
#
# Copy this file to .env and fill in the values you need.
# NEVER commit the real .env file - it contains secrets.
#
# USAGE MODES:
# 1. Direct API mode: paste an API key in the app UI.
#    Provider choices: OpenCode / Gemini / OpenAI. Mistral can be loaded here.
# 2. BigPickle ChatGPT browser bridge mode: leave the UI API key blank
#    and run `run-all.bat`.
#
# ─────────────────────────────────────────────────────────────────────────────
# DIRECT API KEYS (optional unless you want automatic Mistral rotation)
# ─────────────────────────────────────────────────────────────────────────────

# Optional. Comma-separated list of Mistral API keys.
# Used by the app for image-prompt generation when Provider = Mistral.
# If left empty, you can still paste an OpenAI/Gemini/OpenCode key in the UI.
VITE_MISTRAL_KEYS=""

# Optional. OpenCode (Zen / Antigravity-managed) API key.
# The app calls /api-opencode/zen/v1/chat/completions when Provider = OpenCode.
# Can also be typed into the app UI.
OPENCODE_ZEN_API_KEY=""
OPENCODE_GO_API_KEY=""

# Optional. Supabase persistence.
VITE_SUPABASE_URL=""
VITE_SUPABASE_ANON_KEY=""

# ─────────────────────────────────────────────────────────────────────────────
# PORTS & URLS FOR THE BIGPICKLE CHATGPT BROWSER BRIDGE
# Defaults are chosen to avoid common ports:
#   Vite old port 19323, bridge old port 19322, Chrome CDP default 19321.
# ─────────────────────────────────────────────────────────────────────────────

# Port the Express bridge server listens on.
BIGPICKLE_PORT=19322

# Host/port where the Vite dev server runs.
VITE_PORT=19323
VITE_HOST=127.0.0.1

# Chrome DevTools Protocol (CDP) host.
# Chrome must be launched with --remote-debugging-port = 19323 before the bridge starts.
BIGPICKLE_CDP_HOST=http://127.0.0.1:19321
BIGPICKLE_HEADLESS="false"

# Frontend URL used by the bridge client.
VITE_BIGPICKLE_BRIDGE="http://127.0.0.1:19322"
